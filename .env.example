# vps-alert configuration. Installed at /etc/vps-alert/vps-alert.env, mode 600.

# --- Telegram (required) ---
# Token from @BotFather.
BOT_TOKEN=
# The only chat the bot will talk to. Private chat: your user ID.
# Group: negative ID, e.g. -1001234567890.
ALLOWED_CHAT_ID=
# Comma separated user IDs allowed to give commands. Strongly recommended for
# groups: if empty, every group member can control the server.
ALLOWED_USER_IDS=

# Name shown in messages. Defaults to the hostname.
SERVER_NAME=

# --- Backups ---
# Encrypts every backup. Store a copy somewhere safe: without it backups
# CANNOT be restored.
RESTIC_PASSWORD=
BACKUP_LOCAL_REPO=/var/backups/vps-alert
# Optional shell command run before each backup, e.g. a database dump into a
# backed up directory. Configured here only, never from the bot.
# BACKUP_PRE_COMMAND=runuser -u postgres -- pg_dumpall > /var/backups/db/all.sql
BACKUP_PRE_COMMAND=

# Cloudflare R2 (optional). Create an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=vps-alert

# --- Login alerts ---
# Comma separated IPs/CIDRs whose logins are not reported.
LOGIN_IP_WHITELIST=

# --- Dead man's switch (optional) ---
# Pinged every HEARTBEAT_INTERVAL. If pings stop, that service alerts you
# (e.g. a healthchecks.io check URL or an Uptime Kuma push URL).
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=5m

# DATA_DIR=/var/lib/vps-alert
